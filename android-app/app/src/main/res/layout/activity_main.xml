<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textColor="#16161D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_subtitle"
            android:textColor="#646473"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/backendUrlInput"
            android:text="@string/backend_url_label"
            android:textColor="#24242C"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/backendUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:inputType="textUri"
            android:singleLine="true"
            android:text="@string/default_backend_url" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/generation_mode_label"
            android:textColor="#24242C"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/generationModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/textModeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checked="true"
                android:gravity="center"
                android:text="@string/mode_text" />

            <RadioButton
                android:id="@+id/imageModeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/mode_image" />

            <RadioButton
                android:id="@+id/referenceModeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/mode_reference" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/imageUploadSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/imageUploadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_upload_single_label"
                android:textColor="#24242C"
                android:textStyle="bold" />

            <Button
                android:id="@+id/selectImagesButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/select_images" />

            <TextView
                android:id="@+id/selectedImagesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_image_selected"
                android:textColor="#646473"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/promptInput"
            android:text="@string/prompt_label"
            android:textColor="#24242C"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:text="@string/default_prompt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/parameters_label"
            android:textColor="#24242C"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/resolutionSpinner"
                android:text="@string/resolution_label" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:entries="@array/resolution_options"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/ratioSpinner"
                android:text="@string/ratio_label" />

            <Spinner
                android:id="@+id/ratioSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:entries="@array/ratio_options"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/durationSpinner"
                android:text="@string/duration_label" />

            <Spinner
                android:id="@+id/durationSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:entries="@array/duration_options"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <Switch
            android:id="@+id/promptExtendSwitch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/prompt_extend_label" />

        <Switch
            android:id="@+id/watermarkSwitch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checked="true"
            android:text="@string/watermark_label" />

        <TextView
            android:id="@+id/parametersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#646473"
            android:textSize="13sp" />

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/start_generation" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#ECECF4"
            android:padding="14dp"
            android:text="@string/status_ready"
            android:textColor="#24242C"
            android:textIsSelectable="true" />

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="236dp"
            android:layout_height="420dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="#111111"
            android:visibility="gone">

            <TextureView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
